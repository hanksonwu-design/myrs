# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API).
# Leave both empty to run the localStorage demo mode instead.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Login methods on /login: email, phone, or both (phone,email).
# Add google (e.g. google,email) once the Google provider is on in Supabase Auth.
# Phone needs an SMS provider (or test numbers) configured in Supabase Auth.
NEXT_PUBLIC_LOGIN_METHODS=email
